{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://youtube.shareplane.malott.ai/catalog.schema.json",
  "title": "GhostMesh Reader catalog v1",
  "type": "object",
  "required": ["schemaVersion", "host", "revision", "categories", "featuredId", "readers"],
  "properties": {
    "schemaVersion": {"const": 1},
    "host": {"type": "string", "format": "uri"},
    "revision": {"type": "string", "format": "date-time"},
    "featuredId": {"type": "string"},
    "categories": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "readers": {"type": "array", "minItems": 13, "items": {"$ref": "#/$defs/reader"}}
  },
  "$defs": {
    "reader": {
      "type": "object",
      "required": ["id", "slug", "title", "category", "tags", "entities", "source", "published", "updated", "overview", "whyItMatters", "ghostMeshTakeaway", "verdict", "architectureImpact", "claims", "references", "relationships", "relationshipDisposition", "relationshipReview", "review", "revisionHistory", "editorialOrder"],
      "properties": {
        "id": {"type": "string", "pattern": "^reader:[a-z0-9-]+$"},
        "slug": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "source": {"oneOf": [{"$ref": "#/$defs/mediaSource"}, {"$ref": "#/$defs/paperSource"}, {"$ref": "#/$defs/articleSource"}, {"$ref": "#/$defs/repositorySource"}]},
        "verdict": {"enum": ["Essential", "Worth studying", "Interesting, unproven", "Mostly recycled", "Misleading", "Not worth your time"]},
        "claims": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/claim"}},
        "references": {"type": "array", "items": {"$ref": "#/$defs/reference"}},
        "relationships": {"type": "array", "items": {"$ref": "#/$defs/relationship"}},
        "relationshipDisposition": {"type": "string", "minLength": 1},
        "relationshipReview": {"$ref": "#/$defs/relationshipReview"},
        "editorialDepth": {"type": "object", "additionalProperties": false, "required": ["schemaVersion", "receiptPath"], "properties": {"schemaVersion": {"const": 1}, "receiptPath": {"type": "string", "pattern": "^content/editorial-depth/[a-z0-9-]+\\.json$"}}}
      }
    },
    "mediaSource": {
      "type": "object",
      "required": ["url", "platform", "mediaAspect"],
      "additionalProperties": false,
      "not": {"required": ["kind"]},
      "properties": {
        "url": {"type": "string", "format": "uri"},
        "platform": {"enum": ["YouTube", "Instagram"]},
        "mediaAspect": {"enum": ["16:9", "9:16", "1:1", "unknown"]},
        "videoId": {"type": "string"},
        "shortcode": {"type": "string"},
        "channel": {"type": "string"},
        "creator": {"type": "string"},
        "creatorChapters": {"type": "array"},
        "captionTrack": {"type": "string"},
        "captionType": {"type": "string"},
        "durationSeconds": {"type": "number"},
        "title": {"type": "string"},
        "uploadDate": {"type": "string"},
        "publicationDate": {"type": "string"},
        "dateNote": {"type": "string"}
      }
    },
    "paperSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "identity", "url", "htmlUrl", "pdfUrl", "title", "authors", "publisher", "version", "versionDate", "dateNote"],
      "properties": {
        "kind": {"const": "paper"},
        "identity": {"type": "string", "pattern": "^arxiv:[0-9]{4}\\.[0-9]{4,5}v[1-9][0-9]*$"},
        "url": {"type": "string", "format": "uri"},
        "htmlUrl": {"type": "string", "format": "uri"},
        "pdfUrl": {"type": "string", "format": "uri"},
        "title": {"type": "string", "minLength": 1},
        "authors": {"type": "string", "minLength": 1},
        "publisher": {"type": "string", "minLength": 1},
        "version": {"type": "string", "pattern": "^v[1-9][0-9]*$"},
        "versionDate": {"type": "string", "format": "date"},
        "dateNote": {"type": "string", "minLength": 1}
      }
    },
    "articleSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "identity", "url", "title", "authors", "publisher", "publicationDate", "updatedDate", "dateNote"],
      "properties": {
        "kind": {"const": "article"},
        "identity": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{5,}$"},
        "url": {"type": "string", "format": "uri"},
        "title": {"type": "string", "minLength": 1},
        "authors": {"type": "string", "minLength": 1},
        "publisher": {"type": "string", "minLength": 1},
        "publicationDate": {"type": "string", "format": "date"},
        "updatedDate": {"type": "string", "format": "date"},
        "dateNote": {"type": "string", "minLength": 1}
      }
    },
    "repositorySource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "identity", "url", "repositoryUrl", "repository", "commit", "title", "authors", "publisher", "license", "createdDate", "commitDate", "dateNote"],
      "properties": {
        "kind": {"const": "repository"},
        "identity": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{5,}$"},
        "url": {"type": "string", "format": "uri"},
        "repositoryUrl": {"type": "string", "format": "uri"},
        "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "title": {"type": "string", "minLength": 1},
        "authors": {"type": "string", "minLength": 1},
        "publisher": {"type": "string", "minLength": 1},
        "license": {"type": "string", "minLength": 1},
        "createdDate": {"type": "string", "format": "date"},
        "commitDate": {"type": "string", "format": "date"},
        "dateNote": {"type": "string", "minLength": 1}
      }
    },
    "claim": {
      "type": "object",
      "required": ["id", "proposition", "kind", "asOf", "status", "assessment", "limits", "sourceLocation", "references", "counterevidence"],
      "properties": {
        "status": {"enum": ["corroborated", "partially corroborated", "contradicted", "disputed", "unverified"]},
        "asOf": {"type": "string", "format": "date"},
        "references": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "counterevidence": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "reference": {
      "type": "object",
      "required": ["id", "title", "author", "publisher", "url", "publicationDate", "eventDate", "location", "sourceType", "independence", "evidenceFamily", "checkedAt"],
      "properties": {"url": {"type": "string", "format": "uri"}, "checkedAt": {"type": "string", "format": "date-time"}}
    },
    "relationshipReview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewedAt", "reviewedCatalogSize", "decision", "reviewedTargets", "rationale"],
      "properties": {
        "reviewedAt": {"type": "string", "format": "date"},
        "reviewedCatalogSize": {"type": "integer", "minimum": 1},
        "decision": {"enum": ["linked", "none"]},
        "reviewedTargets": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^reader:[a-z0-9-]+$"}},
        "rationale": {"type": "string", "minLength": 80}
      }
    },
    "relationship": {
      "type": "object",
      "required": ["target", "type", "reason", "provenance", "basis", "direction"],
      "properties": {
        "type": {"enum": ["examines same claim", "extends", "challenges", "responds to", "shares entity", "informs architecture", "related topic"]},
        "direction": {"const": "outgoing"},
        "provenance": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    }
  }
}
