{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://youtube.shareplane.malott.ai/source-map.schema.json",
  "title": "GhostMesh public-safe source cue map v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "readerId", "sourceId", "sourceAidSha256", "points"],
  "properties": {
    "schemaVersion": {"const": 1},
    "readerId": {"type": "string", "pattern": "^reader:[a-z0-9-]+$"},
    "sourceId": {"type": "string", "minLength": 1},
    "sourceAidSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "points": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["atSeconds", "sectionId", "claimIds", "cueParaphrase", "privateAidCheck"], "properties": {
      "atSeconds": {"type": ["integer", "null"], "minimum": 0},
      "sectionId": {"type": "string", "minLength": 1},
      "claimIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
      "cueParaphrase": {"type": "string", "minLength": 35},
      "privateAidCheck": {"type": "string", "minLength": 35}
    }}}
  }
}
